# Copy to .env (same folder as this file) and fill in. Never commit .env.

# Your timezone as an IANA name, used for times in reports (e.g. Europe/Berlin, America/New_York). Default UTC.
TIMEZONE=UTC

# Instagram API with Instagram Login (Meta developer app)
INSTAGRAM_USER_ID=                # numeric id of your Instagram professional account (`setup-instagram --write` fills it)
INSTAGRAM_ACCESS_TOKEN=           # long-lived Instagram user token (valid 60 days; the scheduler renews it weekly)
INSTAGRAM_GRAPH_HOST=https://graph.instagram.com
META_GRAPH_VERSION=v26.0          # Graph API version used in requests

# Tuning (defaults are safe; do not raise without a reason)
ENGAGE_DELAY_MIN_S=8              # random pause between replies/DMs, lower bound (seconds)
ENGAGE_DELAY_MAX_S=25             # upper bound (seconds)
ENGAGE_MAX_CALLS_PER_RUN=170      # hard API-call budget per run; Meta's app limit is 200 calls/hour x app users

# Optional: use a different project root than the repo folder
# COMMENT_DM_ROOT=
